{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"moduleResolution": "bundler",
		"skipLibCheck": true,
		"allowJs": true,
		"paths": { "#lib": ["./src/lib"], "#lib/*": ["./src/lib/*"] }
	},
	"include": ["src", "test", "*"],
	"exclude": ["src/service-worker", "src/service-worker.ts"]
}
