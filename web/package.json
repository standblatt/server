{
	"name": "web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "lingui compile --typescript && vite dev",
		"build": "lingui extract --clean && lingui compile --typescript && vite build",
		"check": "lingui compile --typescript && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"prepare": "svelte-kit sync || echo \"\"",
		"i18n": "lingui extract --clean && lingui compile --typescript",
		"api": "openapi-typescript openapi.json -o src/lib/api.gen.ts"
	},
	"devDependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@lingui/cli": "^6.9.1",
		"@lingui/conf": "^6.9.1",
		"@lingui/core": "^6.9.1",
		"@lingui/format-po-gettext": "^6.9.1",
		"@lucide/svelte": "^1.57.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/svelte-query": "^6.3.3",
		"@types/node": "^26.6.5",
		"bits-ui": "^2.19.5",
		"cn": "^0.4.0",
		"csstype": "^3.2.3",
		"lingui-for-svelte": "^0.7.1",
		"marked": "^18.1.1",
		"mode-watcher": "^1.1.0",
		"openapi-fetch": "^0.17.0",
		"openapi-typescript": "^7.13.0",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"svelte-sonner": "^1.2.1",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"unplugin-lingui-macro": "^0.4.1",
		"vite": "^8.3.0"
	},
	"overrides": {
		"openapi-typescript": {
			"typescript": "$typescript"
		},
		"cookie": "^0.7.2"
	}
}
