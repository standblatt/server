#. type: Title ##
#: ../src/help/en/reference/modules.md:74
#, markdown-text, no-wrap
msgid "Event kinds {#kinds}"
msgstr ""

#. type: Plain text
#: ../src/help/en/reference/modules.md:77
#, markdown-text, no-wrap
msgid "**New event** asks for the kind; it only switches modules on, everything can be changed later.\n"
msgstr ""

#. type: Plain text
#: ../src/help/en/reference/modules.md:85
#, markdown-text, no-wrap
msgid "| Kind | Modules |\n|---|---|\n| Shooting festival | Lane assignment, Reservations, Lane sheet, Control strip, Awards, Special prizes, Club competition, Kiosk displays, Helper links |\n| Annual programme or training | Attempts, Classifications |\n| Feldschiessen | Lane assignment, Awards, Club competition, Kiosk displays, Helper links |\n| Club championship | Attempts, Classifications, Kiosk displays |\n| Custom selection | none |\n"
msgstr ""

#. type: Plain text
#: ../src/help/en/reference/modules.md:86
#, markdown-text
