msgstr ""

#. type: Bullet: '- '
#: ../src/help/en/reference/documents.md:22
#, markdown-text
msgid "Helper links print only the lane sheet (ammunition desk) or print forms (scorer, results clerk), and only of their lanes."
msgstr ""

