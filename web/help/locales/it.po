"{\n"
"  \"format\": \"standblatt.programme\",\n"
"  \"version\": 1,\n"
"  \"programme\": {\n"
"    \"name\": \"Championship\",\n"
"    \"variant\": \"Sport\",\n"
"    \"description\": \"\",\n"
"    \"barcode\": \"700005002334864165956154\",\n"
"    \"countsForClubCompetition\": true,\n"
"    \"showOnRankings\": true,\n"
"    \"series\": [\n"
"      { \"shots\": 10, \"maxPoints\": 100, \"trackMouches\": false, \"name\": \"\" }\n"
