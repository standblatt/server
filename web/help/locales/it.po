"    ],\n"
"    \"awards\": [\n"
"      {\n"
"        \"name\": \"Wreath card CHF 10\",\n"
"        \"kind\": \"card\",\n"
"        \"value\": 10,\n"
"        \"limits\": [{ \"ageCategory\": \"elite\", \"points\": 370 }]\n"
"      }\n"
"    ]\n"
"  }\n"
"}\n"
msgstr ""
"{\n"
"  \"format\": \"standblatt.programme\",\n"
"  \"version\": 1,\n"
"  \"programme\": {\n"
"    \"name\": \"Championship\",\n"
"    \"variant\": \"Sport\",\n"
"    \"description\": \"\",\n"
