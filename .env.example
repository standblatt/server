# Copy to .env for local development (make dev does this on first start).

DATABASE_URL=postgres://standblatt:standblatt@localhost:5433/standblatt
STANDBLATT_LISTEN=:8080
STANDBLATT_METRICS_LISTEN=:9090
STANDBLATT_LOG_LEVEL=info
STANDBLATT_TRUST_PROXY=false

# Local development only; in production use a secret from: openssl rand -base64 32
STANDBLATT_ADMIN_TOKEN=dev-admin-token-dev-admin-token-dev

# Personal training log: open sign-up. Mails go to Mailpit (http://localhost:8025) started by make dev.
STANDBLATT_PUBLIC_URL=http://localhost:5173
STANDBLATT_SIGNUP=true
STANDBLATT_TOTP=true
STANDBLATT_PRICE_LABEL="CHF 4.– / month"
STANDBLATT_SMTP_HOST=localhost
STANDBLATT_SMTP_PORT=1025
STANDBLATT_SMTP_FROM="Standblatt <noreply@standblatt.ch>"
